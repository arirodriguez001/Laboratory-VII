[ T-Track ]
    title = [t-track] in xyz mesh
     mesh =  xyz            # mesh type is xyz scoring mesh
   x-type =    4            # x-mesh is linear given by xmin, xmax and xdel
     xmin =  -5.000000      # minimum value of x-mesh points
     xmax =   5.000000      # maximum value of x-mesh points
     xdel =  0.3000000      # mesh width of x-mesh points
#      nx =   34            # number of x-mesh points
#    data = ( x(i), i = 1, nx + 1 )
#          -5.00000E+00 -4.70000E+00 -4.40000E+00 -4.10000E+00 -3.80000E+00
#          -3.50000E+00 -3.20000E+00 -2.90000E+00 -2.60000E+00 -2.30000E+00
#          -2.00000E+00 -1.70000E+00 -1.40000E+00 -1.10000E+00 -8.00000E-01
#          -5.00000E-01 -2.00000E-01  1.00000E-01  4.00000E-01  7.00000E-01
#           1.00000E+00  1.30000E+00  1.60000E+00  1.90000E+00  2.20000E+00
#           2.50000E+00  2.80000E+00  3.10000E+00  3.40000E+00  3.70000E+00
#           4.00000E+00  4.30000E+00  4.60000E+00  4.90000E+00  5.20000E+00
   y-type =    1            # y-mesh is given by the below data
       ny =      1          # number of y-mesh points
#    data = ( y(i), i = 1, ny + 1 )
            1.00000E-02  1.00000E-01
   z-type =    4            # z-mesh is linear given by zmin, zmax and zdel
     zmin =  -5.000000      # minimum value of z-mesh points
     zmax =   5.000000      # maximum value of z-mesh points
     zdel =  0.3000000      # mesh width of z-mesh points
#      nz =   34            # number of z-mesh points
#    data = ( z(i), i = 1, nz + 1 )
#          -5.00000E+00 -4.70000E+00 -4.40000E+00 -4.10000E+00 -3.80000E+00
#          -3.50000E+00 -3.20000E+00 -2.90000E+00 -2.60000E+00 -2.30000E+00
#          -2.00000E+00 -1.70000E+00 -1.40000E+00 -1.10000E+00 -8.00000E-01
#          -5.00000E-01 -2.00000E-01  1.00000E-01  4.00000E-01  7.00000E-01
#           1.00000E+00  1.30000E+00  1.60000E+00  1.90000E+00  2.20000E+00
#           2.50000E+00  2.80000E+00  3.10000E+00  3.40000E+00  3.70000E+00
#           4.00000E+00  4.30000E+00  4.60000E+00  4.90000E+00  5.20000E+00
   e-type =    1            # e-mesh is given by the below data
       ne =      1          # number of e-mesh points
#    data = ( e(i), i = 1, ne + 1 )
            0.00000E+00  1.00000E+03
     unit =    1            # unit is [1/cm^2/source]
 material =  all            # (D=all) number of specific material
  2D-type =    3            # 1:Cont, 2:Clust, 3:Color, 4:xyz, 5:mat, 6:Clust+Cont, 7:Col+Cont
     axis =      xz            # axis of output
     file = ./out/track_xz_10MeV.out  # file name of output for the above axis
     part =  proton   
# kf/name :  2212     
    gshow =    1            # 0: no 1:bnd, 2:bnd+mat, 3:bnd+reg 4:bnd+lat 5:bmp style
    resol =    1            # (D=1) resolution of gshow or rshow
    width = 0.5000000       # (D=0.5) width of lines for gshow or rshow
   epsout =    1            # (D=0) generate eps file by ANGEL
#    used :        main (  %)        temp (  %)       total (  %)
#  memory :          78 (  0)           0 (  0)          78 (  0)

