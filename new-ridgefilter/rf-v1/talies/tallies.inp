[ T - T r a c k ] 
mesh = xyz
x-type = 4
xdel = 0.3
xmin = -5
xmax = 5
z-type = 4
zdel = 0.3
zmin = -5
zmax = 5
y-type = 1
ny = 1
0.01 0.1
part = proton
e-type = 1
ne = 1
0.0 1000.0
unit = 1
axis = xz
file = ./out/track_xz_10MeV.out
gshow = 1
epsout = 1

[ T - T r a c k ] 
mesh = xyz
x-type = 4
xdel = 0.3
xmin = -5
xmax = 5
y-type = 4
ydel = 0.3
ymin = -5
ymax = 5
z-type = 1
nz = 1
0.01 0.1
part = proton
e-type = 1
ne = 1
0.0 1000.0
unit = 1
axis = xy
file = ./out/track_xy_10MeV.out
gshow = 1
epsout = 1

[ T-Deposit ]
title    = Curva de dosis en profundidad (Bragg peak)
mesh     = xyz                  $ Malla cartesiana
x-type   = 2
xmin     = -0.5
xmax     =  0.5
nx       =  1
y-type   = 2
ymin     = -0.5
ymax     =  0.5
ny       =  1
z-type   = 2
zmin     = -0.5                 $ Inicio en z = -0.5 cm
zmax     =  0.6                 $ Fin en z = 0.6 cm
nz       =  1100                $ 1.1 cm / 0.001 cm = 1100 bins
unit     = 0                    $ [Gy/source] (o unit = 1 para [MeV/cm^3/source])
axis     = z                    $ Perfil 1D en funcion de z
output   = dose                 $ Evalua la dosis absorbida
file     = ./out/pico_bragg10MeV.out
part     = all
epsout   = 1
