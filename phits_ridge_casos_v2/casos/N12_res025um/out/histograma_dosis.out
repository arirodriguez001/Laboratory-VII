   6.0480E+01   6.0530E+01   1.0148E-03  0.7330
   6.0530E+01   6.0580E+01   1.0717E-03  1.0000

#   sum over    2.0000E-03   1.0863E-03  0.5787

'no. =  1,  ix =  1,  iy =  1'
msuc: {\huge Histograma}
msdr: {\it plotted by \ANGEL \version}
msdl: {\it calculated by \PHITS  3.36}
wt: s(0.7)
\vspace{-3}
