#   y = (  -8.0000E-01  -  -7.0000E-01  )

x: z[cm]
y: Dose [Gy/source]      
p: xlin ylog afac(0.8) form(0.9)
h: n            x            y(proton  ),hh0l n 
#  z-lower      z-upper        proton    r.err 
   6.0380E+01   6.0430E+01   3.5159E-04  1.0000
   6.0430E+01   6.0480E+01   4.1510E-04  0.7032
   6.0480E+01   6.0530E+01   1.0421E-03  0.5666
   6.0530E+01   6.0580E+01   1.8921E-03  0.3840

#   sum over    2.0000E-03   9.2523E-04  0.3333

'no. =  1,  ix =  1,  iy =  1'
msuc: {\huge Histograma}
msdr: {\it plotted by \ANGEL \version}
msdl: {\it calculated by \PHITS  3.36}
wt: s(0.7)
\vspace{-3}
  xmin  &=&  -1.6500E+00 [cm]
  xmax  &=&  -1.5500E+00 [cm]
