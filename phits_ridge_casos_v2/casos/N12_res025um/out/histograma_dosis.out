#   y = (  -8.0000E-01  -  -7.0000E-01  )

x: z[cm]
y: Dose [Gy/source]      
p: xlin ylog afac(0.8) form(0.9)
h: n            x            y(proton  ),hh0l n 
#  z-lower      z-upper        proton    r.err 
   6.0380E+01   6.0430E+01   1.5724E-03  1.0000
