set: c30[ 43.3e-4 ] $dispersor 1 thickness
set: %disp1_TR%[20]	$disp 1 translation number (leave blank for not)

$[ Surface ]
1200 PX  -30.0
1201 PX   30.0
1202 PY  -19.0
1203 PY   19.0
1204 %disp1_TR% PZ   (-0.6-1.0)
1205 %disp1_TR% PZ   (c30+0.30+1.0)
$set:%disp1_zone%[1200 -1201 1202 -1203 1204 -1205]
set:%disp1_zone%[1204 -1205]	$use with %workzone%

$Pb foil
1206 PX  -2.0
1207 PX   2.0
1208 PY  -2.0
1209 PY   2.0
1210 %disp1_TR% PZ   0.0
1211 %disp1_TR% PZ   c30
set:%disp1_foil%[1206 -1207  1208 -1209  1210 -1211]

$O-ring
1212 %disp1_TR% TZ  0 0 -0.15  (1.5+0.3) 0.15 0.15
set:%oring%[-1212]

$ dispersor 1 sandwiches
1213 PX -3.25
1214 PX  3.25
1215 PY -3.25
1216 PY  3.25
1217 %disp1_TR% PZ -0.60	$top sandwich
1218 %disp1_TR% PZ -0.30 
1219 %disp1_TR% PZ (c30+0.30)	$bottom sandwich
1220 CZ   1.5 $ beam hole
set:%disp1_sandw%[1213 -1214 1215 -1216  1217 -1219 #(1218 -1211) 1220]

$ plate
1221 PX -14.75 
1222 PX  14.75 
1223 PY -4.5 
1224 PY  4.5 
$plate slot
1225 PX -2.535
1226 PX  2.535
1227 PY (4.5-2.23)
set:%disp1_plate%[1221 -1222 1223 -1224  1218 -1211 #(1225 -1226 -1227)]