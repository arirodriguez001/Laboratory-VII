epsout = 1

[T-Track]
title = Espectro de protones en pouch
mesh = reg
reg = 510
part = proton

e-type = 2
emin = 0.0
emax = 25.0
ne = 20

axis = eng
unit = 2
file = ./out/espectro.out
epsout = 1