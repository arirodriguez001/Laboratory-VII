[ T - T r a c k ] $ flujo de protones a la altura del pouch
mesh = xyz
x-type = 4
xdel = 0.3 
xmin= -10 
xmax=  10
y-type = 4
ydel = 0.3                
ymin= -10 
ymax=  10               
z-type = 1
nz = 1
60.47 60.49            
part = proton photon 
e-type = 1
ne = 1
0.0 1000.0
unit = 1
axis = xy
file = ./out/track_xy.out
gshow = 1
epsout = 1


[ T - T r a c k ] off $ flujo de particulas en yz
mesh = xyz
x-type = 1
nx = 1
0. 0.1
y-type = 2
ny = 150          
ymin = -10.
ymax = 10.
z-type = 2            
nz = 500
zmin = -10 
zmax = 110.
part = proton
e-type = 1
ne = 1
0.0 1000.0
unit = 1
axis = yz
file = ./out/track_yz.out
gshow = 1
epsout = 1

[ T - D e p o s i t ]  $ dosis depositada en profundidad
title = Bragg peak in pouch
mesh = r-z
r-type = 2
rmin = 0.0
rmax = 0.5
nr = 1
z-type = 2 
zmin = 97
zmax = 100           
nz = 300                    
part = proton
output = dose
unit = 0
axis = z
file = ./out/bragg_pouch_z.out
epsout = 1

[ T - D e p o s i t ]  $ dosis radial en el pouch
title = Bragg peak in pouch, ahora con radio 1
mesh = r-z
r-type = 2
rmin = 0.0
rmax = 1.7     
nr = 60
z-type = 2
zmin = 60.38
zmax = 60.58
nz = 1
part = proton
output = dose
unit = 0
axis = r
file = ./out/bragg_pouch_r.out
epsout = 1

[ T - D e p o s i t ]   $ histograma dosis-volumen del pouch
title = Histograma
