#1: Track [cm/(keV/µm)/source]
#2: Dose [MeV/(keV/µm)/source], proportional to y ∗ f (y).
#3: Track [cm/ln(keV/µm)/source]
#4: Dose [MeV/ln(keV/µm)/source], proportional to y ∗ d(y).
#5: Track [cm/source]
#6: Dose [MeV/source]
#7: y * f (y) [dimensionless], where ∫ f (y)dy = 1.
#8: y * d(y) [keV/µm], where ∫ d(y)dy = 1.
#These units are for the case of se-unit=2. For se-unit=1 and
#3, [keV/µm] is replaced by [MeV] and [Gy], respectively.


  [ T - S E D ]  off
    title = Energy distribution
     mesh =  reg            # mesh type is region-wise
     reg  =  300 400 801 802 500 501 502 503 504   
  se-type =    3            # e-mesh is log given by emin, emax and ne
    emin  =  1e-09  # minimum value of e-mesh points
    emax  =  10     # maximum value of e-mesh points
       ne =   200           # number of e-mesh points
  se-unit =    1            # 1: deposit energy ε in MeV
     unit =    7            #  y * f (y) [dimensionless], where ∫ f (y)dy = 1.
    cdiam =   c10           # (D=1.0) diameter of SE cell [um]
 material =  all            # (D=all) number of specific material
     axis =  sed
     file = ./out/E-distribution-unit-7.out 
     part =  proton alpha Li       
   #epsout1 =    1
   model=1
 
   [ T - S E D ] off 
    title = Energy distribution
     mesh =  reg            # mesh type is region-wise
    reg   =  300 400 801  802 500 501 502 503 504        
             s-type =    3            # e-mesh is log given by emin, emax and ne
    emin  =  1e-09  # minimum value of e-mesh points
    emax  =  10     # maximum value of e-mesh points
       ne =   200           # number of e-mesh points
  se-unit =    1            # 1: deposit energy ε in MeV
     unit =    8            #  y * d (y) [dimensionless], where ∫ d(y) dy = 1.
    cdiam =   c10           # (D=1.0) diameter of SE cell [um]
 material =  all            # (D=all) number of specific material
     axis =  sed
     file = ./out/E-distribution-unit-8.out  # file name of out1put for the above axis
     part =  proton alpha Li       
   #epsout1 =    1
   model=1 
 
