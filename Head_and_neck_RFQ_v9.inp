[ T - T r a c k ] 
     mesh =  xyz           # mesh type is xyz scoring mesh
   x-type =    2            # x-mesh is linear given by xmin, xmax and nx
       nx =   300            # number of x-mesh points
     xmin =    -1*c1        # minimum value of x-mesh points
     xmax =    (c7+1)*c1       # maximum value of x-mesh points
   y-type =    2            # x-mesh is linear given by xmin, xmax and nx
       ny =    300         # number of x-mesh points
     ymin =   -1*c2      # minimum value of x-mesh points
     ymax =    (c8+1)*c1      # maximum value of x-mesh points
   z-type =    1           # z-mesh is linear given by zmin, zmax and nz
        nz =   1             # number of z-mesh points
            74*c3  75*c3
     part =  neutron 
   e-type =    1            # e-mesh is given by the below data
       ne =    1            # number of e-mesh points
            0.0  1000.0
     unit =    1            # unit is [1/cm^2/source]
     axis =   xy            # axis of out1put
     file = ./out/kerma-xy-total.out  # file name of out1put for the above axis
    title = Dose [Gy/source] using multiplier
    gshow =    1            # 0: no 1:bnd, 2:bnd+mat, 3:bnd+reg 4:bnd+lat
