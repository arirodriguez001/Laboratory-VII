     mat        mset1                   mset2                   mset3
      all (9.7312e-012 2001 1 -4) (1.7888e-013 2002 1 -4) (9.6352e-17 2003 1 -4)
  $ 9.7312e-12 = 1.6e-10*6.082E-02, where 6.082E-02 is atomic density of H in 10^24/g
  $ 1.7888e-13 = 1.6e-10*1.118E-03, where 1.118E-03 is atomic density of N in 10^24/g
  $ 9.6352e-17 = 1.6e-10*6.022E-07*1, where 6.022E-07*1 is atomic density of 10B in 10^24/g (10ppm)
  $ 1.6e-10 is the conversion factor from MeV/g to J/kg
  $ −4 : Average heating number [MeV/collision] 
  z-txt= Gy/source
  y-txt= Dose [Gy/source] 
  
  #90*c1 180*c1 80*c2 190*c2  10*c3 c9*c3
  [ T - T r a c k ]  
     mesh =  xyz           
   x-type =    4           
      xdel =   0.3          
     xmin =    90*c1       
     xmax =    180*c1      
   y-type =    4           
      ydel =   0.3       
     ymin =    80*c2   
     ymax =    190*c2     
   z-type =    4        
     zdel =   0.3           
      zmin =   10*c3 
      zmax =   c9*c3
     part =  neutron 
   e-type =    1            # e-mesh is given by the below data
       ne =    1            # number of e-mesh points
            0.0  1000.0
     unit =    1            # unit is [1/cm^2/source]
     axis =   xy            # axis of out1put
     file = ./out/kerma-mascara-1.out  # file name of out1put for the above axis
    title = Dose [Gy/source] using multiplier (KERMA)
    gshow =    1            # 0: no 1:bnd, 2:bnd+mat, 3:bnd+reg 4:bnd+lat
   #epsout1 =    1            # (D=0) generate eps file by ANGEL
     gslat=    3            # muestra celdas del mismo material
    #vtkout1=    1
    multiplier = all $ The following is subsection of multiplier.
     part  = neutron
     emax  = 2.000e+01
     mat        mset1                   mset2                   mset3
      all (9.7312e-012 2001 1 -4) (1.7888e-013 2002 1 -4) (9.6352e-17 2003 1 -4)
  $ 9.7312e-12 = 1.6e-10*6.082E-02, where 6.082E-02 is atomic density of H in 10^24/g
  $ 1.7888e-13 = 1.6e-10*1.118E-03, where 1.118E-03 is atomic density of N in 10^24/g
  $ 9.6352e-17 = 1.6e-10*6.022E-07*1, where 6.022E-07*1 is atomic density of 10B in 10^24/g (10ppm)
  $ 1.6e-10 is the conversion factor from MeV/g to J/kg
  $ −4 : Average heating number [MeV/collision] 
  z-txt= Gy/source
  y-txt= Dose [Gy/source] 
  
   
