[ T - T r a c k ] $ flujo de protones a la altura del pouch
mesh = xyz
x-type = 2
nx = 25               
xmin = -4.
xmax = 4.
y-type = 2
ny = 60                  
ymin = -6.
ymax = 5.
z-type = 1
nz = 1
98.34 98.35              $ centro del pouch z= 98.480 +- 0.01 cm / para ver la cinta: 98.373  98.378
part = proton
e-type = 1
ne = 1
0.0 1000.0
unit = 1
axis = xy
file = track_xy_.out
gshow = 1
epsout = 1

[ T - T r a c k ] $ flujo de particulas en yz
mesh = xyz
x-type = 1
nx = 1
0. 0.1
y-type = 2
ny = 150          
ymin = -10.
ymax = 10.
z-type = 2            
nz = 500
zmin = -10 
zmax = 110.
part = proton 
e-type = 1
ne = 1
0.0 1000.0
unit = 1
axis = yz
file = ./out/track_yz.out
gshow = 1
epsout = 1

[ T - D e p o s i t ]  $ dosis depositada en profundidad
title = Bragg peak in pouch
mesh = r-z
r-type = 2
rmin = 0.0
rmax = 0.5
nr = 1
z-type = 2 
zmin = 97
zmax = 99           
nz = 200 $así tiene error del 1%                    
part = proton
output = dose
unit = 0
axis = z
file = ./out/bragg_pouch_z.out
epsout = 1

[ T - D e p o s i t ]  $ dosis radial en el pouch
title = Bragg peak in pouch, ahora con radio 1
mesh = r-z
r-type = 2
rmin = 0.0
rmax = 1.7     
nr = 60
z-type = 2
zmin = 98.38
zmax = 98.58
nz = 1
part = proton
output = dose
unit = 0
axis = r
file = ./out/bragg_pouch_r.out
epsout = 1

[ T - Track ] $para ver aprox con que energia entran al pouch y estimar el projected range
title = Espectro de energia en el gel
mesh = reg
reg = 600
e-type = 2
ne = 100
emin = 1.0e-9
emax = 25.0
unit = 1
axis = eng
file = ./out/energy_gel.out
part = proton 

[ T - D e p o s i t ]  $ histograma dosis-volumen del pouch
