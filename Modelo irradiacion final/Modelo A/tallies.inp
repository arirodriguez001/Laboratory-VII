
$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$ MODELO A $$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$

$ Tallys para ver la geometria

[ T - T r a c k ]   $ flujo de protones a la altura del pouch

mesh = xyz
x-type = 2
nx = 25               
xmin = -4.
xmax = 4.
y-type = 2
ny = 60                  
ymin = -6.
ymax = 5.
z-type = 1
nz = 1
98.47 98.49            $ centro del pouch z= 98.480 +- 0.01 cm / para ver la cinta: 98.373  98.378 /98.485  98.49
part = proton
e-type = 1
ne = 1
0.0 1000.0
unit = 1
axis = xy
file = track_xy_A.out
gshow = 1
epsout = 1

[ T - T r a c k ] $ flujo de particulas en yz

mesh = xyz
x-type = 1
nx = 1
0. 0.1
y-type = 2
ny = 150          
ymin = -10.
ymax = 10.
z-type = 2            
nz = 500
zmin = -10 
zmax = 110.

part = proton
e-type = 1
ne = 1
0.0 1000.0
unit = 1
axis = yz
file = track_yz_A.out
gshow = 1
epsout = 1

[ T - T r a c k ]   $ flujo de particulas en yz

mesh = xyz
x-type = 1
nx = 1
0. 0.1
y-type = 2
ny = 150          
ymin = -10.
ymax = 10.
z-type = 2            
nz = 500
zmin = -10 
zmax = 110.

part = photon
e-type = 1
ne = 1
0.0 1000.0
unit = 1
axis = yz
file = track_yz_gamma_A.out
gshow = 1
epsout = 1

[ T - T r a c k ]  $ flujo de particulas en yz

mesh = xyz
x-type = 1
nx = 1
0. 0.1
y-type = 2
ny = 150          
ymin = -10.
ymax = 10.
z-type = 2            
nz = 500
zmin = -10 
zmax = 110.

part = neutron
e-type = 1
ne = 1
0.0 1000.0
unit = 1
axis = yz
file = track_yz_neutron_A.out
gshow = 1
epsout = 1



[ T - D e p o s i t ]  $ dosis depositada en profundidad

title = Bragg peak in pouch

mesh = r-z
r-type = 2
rmin = 0.0
rmax = 0.5
nr = 1

z-type = 2 
zmin = 97
zmax = 100           
nz = 100                    

part = proton
output = dose
unit = 0
axis = z
file = bragg_pouch_zA.out
epsout = 1

[ T - D e p o s i t ]  $ dosis radial en el pouch

title = Bragg peak in pouch, ahora con radio 1
mesh = r-z

r-type = 2
rmin = 0.0
rmax = 1.7     
nr = 60

z-type = 2
zmin = 98.38
zmax = 98.58
nz = 1

part = proton
output = dose
unit = 0
axis = r
file = bragg_pouch_rA.out
epsout = 1


[ T - Track ] $ para ver que particulas le llega al hamster

title = Espectro de energia
mesh = reg
reg = 700
e-type = 2
ne = 100
emin = 1.0e-9
emax = 25.0
unit = 1
axis = eng
file = energy_hamster_A.out
part = proton neutron alpha photon positron



[ T - D e p o s i t ] $ histograma dosis-volumen del pouch

title = Histograma

mesh = xyz

x-type = 2
xmin = -0.8
xmax = 0.8
nx = 16

y-type = 2
ymin = -1.65
ymax = 1.65
ny = 33

z-type = 2
zmin = 98.38
zmax = 98.58
nz = 4

part = proton
output = dose
unit = 0
axis = z
file = histograma_dosis_A.out
epsout = 1

[ T - D e p o s i t ]

title = Dosis depositada en el hamster de photones protones

mesh = reg

reg = 700
unit = 0
axis = reg
file = dosis_hamster_A.out
part = proton photon 
output = dose
epsout = 1

[ T - D e p o s i t ]

title = Dosis depositada en el hamster de neutrones

mesh = reg

reg = 700 6007
unit = 0
axis = reg
file = dosis_neutron_hamster_A.out
part = neutron
output = dose
epsout = 1


