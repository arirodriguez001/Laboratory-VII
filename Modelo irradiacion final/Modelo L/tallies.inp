
$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$ MODELO L $$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$

$ Tallys para ver la geometria

[ T - T r a c k ] off  $ flujo de protones a la altura del pouch

mesh = xyz
x-type = 2
nx = 25               
xmin = -4.
xmax = 4.
y-type = 2
ny = 60                  
ymin = -6.
ymax = 5.
z-type = 1
nz = 1
98.34 98.35              $ centro del pouch z= 98.480 +- 0.01 cm / para ver la cinta: 98.373  98.378
part = proton
e-type = 1
ne = 1
0.0 1000.0
unit = 1
axis = xy
file = track_xy_L.out
gshow = 1
epsout = 1

[ T - T r a c k ]off  $ flujo de particulas en yz

mesh = xyz
x-type = 1
nx = 1
0. 0.1
y-type = 2
ny = 150          
ymin = -10.
ymax = 10.
z-type = 2            
nz = 500
zmin = -10 
zmax = 110.

part = proton
e-type = 1
ne = 1
0.0 1000.0
unit = 1
axis = yz
file = track_yz_L.out
gshow = 1
epsout = 1

[ T - T r a c k ]  $ flujo de particulas en yz

mesh = xyz
x-type = 1
nx = 1
0. 0.1
y-type = 2
ny = 150          
ymin = -10.
ymax = 10.
z-type = 2            
nz = 500
zmin = -10 
zmax = 110.

part = photon
e-type = 1
ne = 1
0.0 1000.0
unit = 1
axis = yz
file = track_yz_gamma_L.out
gshow = 1
epsout = 1


[ T - D e p o s i t ]off  $ dosis depositada en profundidad

title = Bragg peak in pouch

mesh = r-z
r-type = 2
rmin = 0.0
rmax = 0.5
nr = 1

z-type = 2 
zmin = 97
zmax = 100           
nz = 100                    

part = proton
output = dose
unit = 0
axis = z
file = bragg_pouch_zL.out
epsout = 1

[ T - D e p o s i t ] off $ dosis radial en el pouch

title = Bragg peak in pouch, ahora con radio 1
mesh = r-z

r-type = 2
rmin = 0.0
rmax = 1.7     $ lo cambie pero antes llegaba a 1
nr = 100

z-type = 2
zmin = 98.38
zmax = 98.58
nz = 1

part = proton
output = dose
unit = 0
axis = r
file = bragg_pouch_rL.out
epsout = 1


[ T - Track ]   off$ para ver que particulas le llega al hamster

title = Espectro de energia
mesh = reg
reg = 700
e-type = 2
ne = 100
emin = 1.0e-9
emax = 25.0
unit = 1
axis = eng
file = energy_hamster_L.out
part = proton neutron alpha photon positron



[ T - D e p o s i t ]off  $ histograma dosis-volumen del pouch

title = Histograma

mesh = xyz
x-type = 2
xmin = -1.0
xmax = 1.0
nx = 10

y-type = 2
ymin = -1.6
ymax = 1.6
ny = 16

z-type = 2
zmin = 98.38
zmax = 98.58
nz = 4

part = proton
output = dose
unit = 0
axis = z
file = histograma_dosis_L.out
epsout = 1

[ T - D e p o s i t ]

title = Dosis depositada en el hamster de photones protones

mesh = reg

reg = 700
unit = 0
axis = reg
file = dosis_hamster_L.out
part = proton photon 
output = dose
epsout = 1