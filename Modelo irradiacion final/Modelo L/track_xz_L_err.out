#           2.40000E+00  2.56000E+00  2.72000E+00  2.88000E+00  3.04000E+00
#           3.20000E+00  3.36000E+00  3.52000E+00  3.68000E+00  3.84000E+00
#           4.00000E+00
   y-type =    1            # y-mesh is given by the below data
       ny =      1          # number of y-mesh points
#    data = ( y(i), i = 1, ny + 1 )
            0.00000E+00  1.00000E-01
   z-type =    2            # z-mesh is linear given by zmin, zmax and nz
     zmin =   95.00000      # minimum value of z-mesh points
     zmax =   105.0000      # maximum value of z-mesh points
#    zdel =  0.2000000      # mesh width of z-mesh points
       nz =     50          # number of z-mesh points
#    data = ( z(i), i = 1, nz + 1 )
#           9.50000E+01  9.52000E+01  9.54000E+01  9.56000E+01  9.58000E+01
