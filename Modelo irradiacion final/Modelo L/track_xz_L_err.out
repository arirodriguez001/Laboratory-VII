[ T-Track ]
    title = [t-track] in xyz mesh
     mesh =  xyz            # mesh type is xyz scoring mesh
   x-type =    2            # x-mesh is linear given by xmin, xmax and nx
     xmin =  -4.000000      # minimum value of x-mesh points
     xmax =   4.000000      # maximum value of x-mesh points
#    xdel =  0.1600000      # mesh width of x-mesh points
       nx =     50          # number of x-mesh points
#    data = ( x(i), i = 1, nx + 1 )
#          -4.00000E+00 -3.84000E+00 -3.68000E+00 -3.52000E+00 -3.36000E+00
#          -3.20000E+00 -3.04000E+00 -2.88000E+00 -2.72000E+00 -2.56000E+00
#          -2.40000E+00 -2.24000E+00 -2.08000E+00 -1.92000E+00 -1.76000E+00
#          -1.60000E+00 -1.44000E+00 -1.28000E+00 -1.12000E+00 -9.60000E-01
#          -8.00000E-01 -6.40000E-01 -4.80000E-01 -3.20000E-01 -1.60000E-01
#           0.00000E+00  1.60000E-01  3.20000E-01  4.80000E-01  6.40000E-01
#           8.00000E-01  9.60000E-01  1.12000E+00  1.28000E+00  1.44000E+00
