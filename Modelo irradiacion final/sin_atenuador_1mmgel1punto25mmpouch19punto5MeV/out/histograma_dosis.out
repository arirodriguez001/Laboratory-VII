[ T-Deposit ]
    title = Histograma dosis-volumen del pouch
     mesh =  xyz            # mesh type is xyz scoring mesh
   x-type =    2            # x-mesh is linear given by xmin, xmax and nx
     xmin = -0.8000000      # minimum value of x-mesh points
     xmax =  0.8000000      # maximum value of x-mesh points
#    xdel =  0.1000000      # mesh width of x-mesh points
       nx =     16          # number of x-mesh points
#    data = ( x(i), i = 1, nx + 1 )
#          -8.00000E-01 -7.00000E-01 -6.00000E-01 -5.00000E-01 -4.00000E-01
#          -3.00000E-01 -2.00000E-01 -1.00000E-01  0.00000E+00  1.00000E-01
#           2.00000E-01  3.00000E-01  4.00000E-01  5.00000E-01  6.00000E-01
#           7.00000E-01  8.00000E-01
   y-type =    2            # y-mesh is linear given by ymin, ymax and ny
     ymin =  -1.650000      # minimum value of y-mesh points
     ymax =   1.650000      # maximum value of y-mesh points
#    ydel =  0.1000000      # mesh width of y-mesh points
       ny =     33          # number of y-mesh points
#    data = ( y(i), i = 1, ny + 1 )
#          -1.65000E+00 -1.55000E+00 -1.45000E+00 -1.35000E+00 -1.25000E+00
#          -1.15000E+00 -1.05000E+00 -9.50000E-01 -8.50000E-01 -7.50000E-01
#          -6.50000E-01 -5.50000E-01 -4.50000E-01 -3.50000E-01 -2.50000E-01
#          -1.50000E-01 -5.00000E-02  5.00000E-02  1.50000E-01  2.50000E-01
#           3.50000E-01  4.50000E-01  5.50000E-01  6.50000E-01  7.50000E-01
#           8.50000E-01  9.50000E-01  1.05000E+00  1.15000E+00  1.25000E+00
#           1.35000E+00  1.45000E+00  1.55000E+00  1.65000E+00
   z-type =    2            # z-mesh is linear given by zmin, zmax and nz
     zmin =   98.45500      # minimum value of z-mesh points
     zmax =   98.58000      # maximum value of z-mesh points
#    zdel =  3.1250000E-02  # mesh width of z-mesh points
       nz =      4          # number of z-mesh points
#    data = ( z(i), i = 1, nz + 1 )
#           9.84550E+01  9.84862E+01  9.85175E+01  9.85487E+01  9.85800E+01
     unit =    0            # unit is [Gy/source]
   letmat =    0            # (D=0) mat ID for LET, 0:real mat, <0: electron for H2O
  dedxfnc =    0            # (D=0) user defined multiplier, 0(no), 1, 2
 material =  all            # (D=all) number of specific material
   output =  dose           # total deposit energy
  deposit =    0            # (D=0) 0-> total deposit dist, 1-> each process
     axis =     z           # axis of output
     file = ./out/histograma_dosis.out  # file name of output for the above axis
     part =  proton   
# kf/name :  2212     
   epsout =    1            # (D=0) generate eps file by ANGEL
   mother =  all            # (D=all) number of specific mother
#    used :        main (  %)        temp (  %)       total (  %)
#  memory :          59 (  0)           0 (  0)          59 (  0)

