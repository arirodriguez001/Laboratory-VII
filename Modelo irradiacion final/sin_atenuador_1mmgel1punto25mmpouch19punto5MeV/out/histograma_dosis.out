   9.8455E+01   9.8486E+01   0.0000E+00  0.0000
   9.8486E+01   9.8517E+01   0.0000E+00  0.0000
   9.8517E+01   9.8549E+01   0.0000E+00  0.0000
   9.8549E+01   9.8580E+01   0.0000E+00  0.0000

#   sum over    1.2500E-03   0.0000E+00  0.0000

'no. =  1,  ix =  1,  iy =  1'
msuc: {\huge Histograma dosis-volumen del pouch}
msdr: {\it plotted by \ANGEL \version}
msdl: {\it calculated by \PHITS  3.35}
