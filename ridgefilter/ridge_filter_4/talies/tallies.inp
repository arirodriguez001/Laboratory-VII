[T-Deposit]
title = Dosis en region 700
mesh = reg
reg = 700
part = proton
output = dose
unit = 0
axis = reg
file = ./out/dosis_region4.out
epsout = 1

[T-Track]
title = Espectro de protones en region 700
mesh = reg
reg = 700
part = proton

e-type = 2
emin = 0.0
emax = 25.0
ne = 20

axis = eng
unit = 2
file = ./out/espectro_region4.out
epsout = 1