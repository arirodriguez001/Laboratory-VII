[ T-Track ]
    title = [t-track] in xyz mesh
     mesh =  xyz            # mesh type is xyz scoring mesh
   x-type =    2            # x-mesh is linear given by xmin, xmax and nx
     xmin = -1.0000000E-02  # minimum value of x-mesh points
     xmax =  1.0000000E-02  # maximum value of x-mesh points
#    xdel =  2.0000000E-02  # mesh width of x-mesh points
       nx =      1          # number of x-mesh points
#    data = ( x(i), i = 1, nx + 1 )
#          -1.00000E-02  1.00000E-02
   y-type =    4            # y-mesh is linear given by ymin, ymax and ydel
     ymin =  -3.000000      # minimum value of y-mesh points
     ymax =   3.000000      # maximum value of y-mesh points
     ydel =  0.3000000      # mesh width of y-mesh points
#      ny =   20            # number of y-mesh points
#    data = ( y(i), i = 1, ny + 1 )
#          -3.00000E+00 -2.70000E+00 -2.40000E+00 -2.10000E+00 -1.80000E+00
#          -1.50000E+00 -1.20000E+00 -9.00000E-01 -6.00000E-01 -3.00000E-01
#           0.00000E+00  3.00000E-01  6.00000E-01  9.00000E-01  1.20000E+00
#           1.50000E+00  1.80000E+00  2.10000E+00  2.40000E+00  2.70000E+00
#           3.00000E+00
   z-type =    2            # z-mesh is linear given by zmin, zmax and nz
     zmin =   95.00000      # minimum value of z-mesh points
     zmax =   100.0000      # maximum value of z-mesh points
#    zdel =  5.0000000E-02  # mesh width of z-mesh points
       nz =    100          # number of z-mesh points
#    data = ( z(i), i = 1, nz + 1 )
#           9.50000E+01  9.50500E+01  9.51000E+01  9.51500E+01  9.52000E+01
#           9.52500E+01  9.53000E+01  9.53500E+01  9.54000E+01  9.54500E+01
