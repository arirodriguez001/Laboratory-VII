[ T-Track ]
    title = [t-track] in xyz mesh
     mesh =  xyz            # mesh type is xyz scoring mesh
   x-type =    2            # x-mesh is linear given by xmin, xmax and nx
     xmin =  -10.00000      # minimum value of x-mesh points
     xmax =   10.00000      # maximum value of x-mesh points
#    xdel =  0.2000000      # mesh width of x-mesh points
       nx =    100          # number of x-mesh points
#    data = ( x(i), i = 1, nx + 1 )
#          -1.00000E+01 -9.80000E+00 -9.60000E+00 -9.40000E+00 -9.20000E+00
#          -9.00000E+00 -8.80000E+00 -8.60000E+00 -8.40000E+00 -8.20000E+00
#          -8.00000E+00 -7.80000E+00 -7.60000E+00 -7.40000E+00 -7.20000E+00
#          -7.00000E+00 -6.80000E+00 -6.60000E+00 -6.40000E+00 -6.20000E+00
#          -6.00000E+00 -5.80000E+00 -5.60000E+00 -5.40000E+00 -5.20000E+00
#          -5.00000E+00 -4.80000E+00 -4.60000E+00 -4.40000E+00 -4.20000E+00
#          -4.00000E+00 -3.80000E+00 -3.60000E+00 -3.40000E+00 -3.20000E+00
#          -3.00000E+00 -2.80000E+00 -2.60000E+00 -2.40000E+00 -2.20000E+00
#          -2.00000E+00 -1.80000E+00 -1.60000E+00 -1.40000E+00 -1.20000E+00
#          -1.00000E+00 -8.00000E-01 -6.00000E-01 -4.00000E-01 -2.00000E-01
#           0.00000E+00  2.00000E-01  4.00000E-01  6.00000E-01  8.00000E-01
#           1.00000E+00  1.20000E+00  1.40000E+00  1.60000E+00  1.80000E+00
#           2.00000E+00  2.20000E+00  2.40000E+00  2.60000E+00  2.80000E+00
#           3.00000E+00  3.20000E+00  3.40000E+00  3.60000E+00  3.80000E+00
#           4.00000E+00  4.20000E+00  4.40000E+00  4.60000E+00  4.80000E+00
#           5.00000E+00  5.20000E+00  5.40000E+00  5.60000E+00  5.80000E+00
#           6.00000E+00  6.20000E+00  6.40000E+00  6.60000E+00  6.80000E+00
#           7.00000E+00  7.20000E+00  7.40000E+00  7.60000E+00  7.80000E+00
#           8.00000E+00  8.20000E+00  8.40000E+00  8.60000E+00  8.80000E+00
#           9.00000E+00  9.20000E+00  9.40000E+00  9.60000E+00  9.80000E+00
#           1.00000E+01
   y-type =    4            # y-mesh is linear given by ymin, ymax and ydel
     ymin = -1.0000000E-02  # minimum value of y-mesh points
     ymax =  1.0000000E-02  # maximum value of y-mesh points
     ydel =  0.1000000      # mesh width of y-mesh points
#      ny =    1            # number of y-mesh points
#    data = ( y(i), i = 1, ny + 1 )
#          -1.00000E-02  9.00000E-02
   z-type =    4            # z-mesh is linear given by zmin, zmax and zdel
     zmin =   95.00000      # minimum value of z-mesh points
     zmax =   100.0000      # maximum value of z-mesh points
     zdel =  0.1000000      # mesh width of z-mesh points
#      nz =   50            # number of z-mesh points
#    data = ( z(i), i = 1, nz + 1 )
#           9.50000E+01  9.51000E+01  9.52000E+01  9.53000E+01  9.54000E+01
#           9.55000E+01  9.56000E+01  9.57000E+01  9.58000E+01  9.59000E+01
#           9.60000E+01  9.61000E+01  9.62000E+01  9.63000E+01  9.64000E+01
#           9.65000E+01  9.66000E+01  9.67000E+01  9.68000E+01  9.69000E+01
#           9.70000E+01  9.71000E+01  9.72000E+01  9.73000E+01  9.74000E+01
#           9.75000E+01  9.76000E+01  9.77000E+01  9.78000E+01  9.79000E+01
#           9.80000E+01  9.81000E+01  9.82000E+01  9.83000E+01  9.84000E+01
#           9.85000E+01  9.86000E+01  9.87000E+01  9.88000E+01  9.89000E+01
#           9.90000E+01  9.91000E+01  9.92000E+01  9.93000E+01  9.94000E+01
#           9.95000E+01  9.96000E+01  9.97000E+01  9.98000E+01  9.99000E+01
#           1.00000E+02
   e-type =    1            # e-mesh is given by the below data
       ne =      1          # number of e-mesh points
#    data = ( e(i), i = 1, ne + 1 )
            0.00000E+00  1.00000E+03
     unit =    1            # unit is [1/cm^2/source]
 material =  all            # (D=all) number of specific material
  2D-type =    3            # 1:Cont, 2:Clust, 3:Color, 4:xyz, 5:mat, 6:Clust+Cont, 7:Col+Cont
     axis =      xz            # axis of output
     file = ./out/detectores-2.out  # file name of output for the above axis
     part =  proton   
# kf/name :  2212     
    gshow =    1            # 0: no 1:bnd, 2:bnd+mat, 3:bnd+reg 4:bnd+lat 5:bmp style
    resol =    1            # (D=1) resolution of gshow or rshow
    width = 0.5000000       # (D=0.5) width of lines for gshow or rshow
   epsout =    1            # (D=0) generate eps file by ANGEL
#    used :        main (  %)        temp (  %)       total (  %)
#  memory :         160 (  0)           0 (  0)         160 (  0)

#------------------------------------------------------------------------------
#newpage:
#   no. =  1   ie  =  1   iy  =  1   part. = proton  
#   e = (   0.0000E+00  -   1.0000E+03  )
#   y = (  -1.0000E-02  -   9.0000E-02  )

'no. =  1,  ie =  1,  iy =  1'
msuc: {\huge [t-track] in xyz mesh}
msdr: {\it plotted by \ANGEL \version}
msdl: {\it calculated by \PHITS  3.36}

x: z [cm]
y: x [cm]
set: c1[ 4.000] c2[ 0.450] c5[ 0.800] c6[ 0.566] c7[ 2.000] c8[ 0.000]
p: h2fs form[c1] xfac[c2] afac[c5] scal[c6] xorg[c7] yorg[c8] nosp
set: c3[1.0e-4] c4[1.0]
p: cmin[c3] cmax[c4]
p: dmin(1e-31)
p: zlog
p: xmin(  95.00000    ) xmax(  100.0000    )
p: ymin( -10.00000    ) ymax(  10.00000    )
#  nx = 100   nz =  50
# ( ( data(z,x), z = 1, nz ), x = nx, 1, -1 )

