[T-Cross] 
title = Proton response in air channel
mesh = reg
reg = 6
r-from   r-to         area
(20002<20005)       (20003<20005)        1.0 $ Aire ->Si 
(20001<20005)       (20003<20005)        1.0 $ Al -> Si 
(20002<20006)       (20003<20006)        1.0 $ Aire ->Si 
(20001<20006)       (20003<20006)        1.0 $ Al -> Si 
(20002<20007)       (20003<20007)        1.0 $ Aire ->Si 
(20001<20007)       (20003<20007)        1.0 $ Al -> Si 
part = proton
output = f-curr
axis=reg 
e-type = 2
ne = 1
emin = 0.0
emax = 1000
epsout = 1
file=./out/protones_detector.out 

