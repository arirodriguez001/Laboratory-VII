[ T - D e p o s i t ]  $ dosis depositada en profundidad
title = Bragg peak in pouch
mesh = r-z
r-type = 2
rmin = 0.0
rmax = 0.5
nr = 1
z-type = 2 
zmin = 80
zmax = 100           
nz = 300                    
part = proton
output = dose
unit = 0
axis = z
file = ./out/bragg_pouch_zL.out
epsout = 1

[ T - D e p o s i t ]  $ dosis radial en el pouch
title = Bragg peak in pouch, ahora con radio 1
mesh = r-z
r-type = 2
rmin = 0.0
rmax = 1.7     
nr = 60
z-type = 2
zmin = 98.38
zmax = 98.58
nz = 1
part = proton
output = dose
unit = 0
axis = r
file = ./out/bragg_pouch_rL.out
epsout = 1

[ T - Track ] off  $ para ver que particulas le llega al hamster
title = Espectro de energia
mesh = reg
reg = 700
e-type = 2
ne = 100
emin = 1.0e-9
emax = 25.0
unit = 1
axis = eng
file = ./out/energy_hamster_L.out
part = proton neutron alpha photon positron

