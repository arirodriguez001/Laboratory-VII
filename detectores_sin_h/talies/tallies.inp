$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$ MODELO L $$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$

[ T - T r a c k ] $ flujo de protones a la altura del pouch
mesh = xyz
x-type = 4
xdel = 0.3                
xmin= -10 
xmax=  10 
#xmin = -4.
#xmax = 4.
y-type = 4
ydel = 0.3 
ymin= -15 
ymax=  15              
z-type = 1
nz = 1
98.470 98.490            $ centro del pouch z= 98.480 +- 0.01 cm / para ver la cinta: 98.373  98.378 /98.485  98.49
part = proton photon 
e-type = 1
ne = 1
0.0 1000.0
unit = 1
axis = xy
file = ./out/track_xy_L.out
gshow = 1
epsout = 1


[ T - T r a c k ] $ flujo de particulas en yz
mesh = xyz
x-type = 1
nx = 1
0. 0.1
y-type = 2
ny = 150          
ymin = -10.
ymax = 10.
z-type = 2            
nz = 500
zmin = -10 
zmax = 110.
part = proton
e-type = 1
ne = 1
0.0 1000.0
unit = 1
axis = yz
file = ./out/track_yz_L.out
gshow = 1
epsout = 1

[ T - T r a c k ]  $ flujo de particulas en yz
mesh = xyz
x-type = 1
