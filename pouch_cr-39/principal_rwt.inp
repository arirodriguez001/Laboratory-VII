$set:%skin%[18  -1.1]

mat[19]  C -0.8563  H -0.1437   $ plastico SRIM (C2H4)
$set:%plastic%[19 -0.93]

mat[20]  C -0.6170  H -0.0850  O -0.2980   $ Scotch Magic Tape 810 aprox: acrilico + acetato de celulosa
$set:%scotch%[20 -1.20]

mat[21]  C 12  H 18  O 7      $ CR-39 (PADC), C12H18O7
$set:%CR39%[21 -1.32]

