$omp=0
$$mpi=32
$rwt=0
[ Title ]
Vertical external proton beam - modular input

[ Parameters ]
$file(1) = /share/gidans/sebastiangossio/Programas/PIHTS-IFORT/phits
file(1) = C:/phits

icntl	= 8 $0: transport	5: source	8: 2D geometry	11: 3D geometry	14: volume	16: script mode	17: Anatally mode
maxcas	= 10000 $ (D=10) number of particles per one batch
maxbch	= 200000 $ (D=10) number of batches
istdev	= 2 $Statistical uncertainties estimated from the standard error of: 1=each batch result. 2=each history result.
nspred	= 2 $2= Coulomb diﬀusion by the Lynch’s formula based on the Moliere theory
nedisp	= 1 $1= Landau Vavilov energy straggling
istdcut	= 1 $Stop when its statistical uncertainty becomes less than stdcut.
delt0	= 4e-5 $Minimum ﬂight mesh [cm], should be set to 1/10 of the minimum thickness of thin films less than 1 cm when describing a scattering process.
ireschk	= 1 $Control parameter for tally consistency check. The inconsistency of a tally may occur as the result of the loss of signiﬁcant digits in the PHITS input ﬁle
nlost	= 10000 $number of tolerance of lost particles before stopping the run.
e-mode	= 0 $When e-mode≠0 and high-energy nuclear data libraries are used, PHITS determines the reaction point using the total cross section contained in the high-energy nuclear data libraries while
$igeomem = 200000
itall    =       0 # 1:actualiza los graficos,0: no actualiza, -1: no graba nada

$  required options for DCHAIN (also e-mode=0)
$ igamma	= 3 $ (D=2) 0:No, 1:Old, 2:EBITEM,3:EBITEM+Isomer
$ jmout	= 1 $ (D=0) Density echo, 0:input, 1:number densityc
$ dmax(1)	= 200.0 $ (D=emin(1)) data max. energy of proton (MeV)
$ dmax(2)	= 200.0 $ (D=emin(2)) data max. energy of neutron (MeV)

set: c1[ 0.5 ]	$beam radius
set: c2[ 19.5 ]	$accelerator terminal tension
$$infl:{c2.inp} $Reemplazar una variable linealmente

$set:%thisdata%[_21MeV_dchain]	$for tallies
file(6)	= ./out/phits.out
file(22) = ./out/batch.out


[ Source ]
totfact	= 1.0e-9 / 1.602177e-19	$Transform from particles to beam current: proton/s = nanocurrent (nA = 10^(-9) C/s) / charge (C/proton)
proj	= proton
s-type	= 1	$1 = monoenergetic, 11 = emitance beam, 13 = xy Gaussian beam
  r0	= c1
  z0	= -3.0	$ minimum position of z-axis [cm]
  z1	= -3.0	$ maximum position of z-axis [cm]
 dir	= 1.0	$ z-direction of beam [cosine]
  e0	= c2

[ Material ]
mat[1] C -0.000124 N -0.755267 O -0.231781 Ar -0.012827	$ air (ICRU)
$dedxfile = air_icru90.txt
$set:%air%[1  -1.205e-3]

mat[2] Al 1	$ aluminum
$set:%Al%[2  -2.6989]

mat[3] Fe -98.5 C -0.25 Mn -0.95 Si -0.3	$ structural steel
$set:%body%[3  -5.2]

