$$$$$ lamina 1 $$$$$

[T-Track]

mesh = reg
reg = 7001
volume
reg    vol
7001   0.054
part = proton
e-type = 2
ne = 1
emin = 1.0e-9
emax = 1000.0
unit = 1
axis = reg 
file = ./out/flujo1_reg.out

[T-Track]

mesh = xyz
x-type = 2
nx = 27
xmin = -1.35
xmax =  1.35
y-type = 2
ny = 8
ymin = 1.0815
ymax = 1.8815
z-type = 2
nz = 1
zmin = 98.380
zmax = 98.405
part = proton
e-type = 2
ne = 1
emin = 1.0e-9
emax = 25.0
unit = 1
axis = xy
file = ./out/flujo1_xyz.out
epsout = 1

