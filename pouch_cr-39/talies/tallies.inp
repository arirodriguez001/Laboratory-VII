x-type = 1
nx = 1
0. 0.1
y-type = 2
ny = 150          
ymin = -10.
ymax = 10.
z-type = 2            
nz = 500
zmin = -10 
zmax = 110.
part = proton
e-type = 1
ne = 1
0.0 1000.0
unit = 1
axis = yz
file = ./out/track_yz_L.out
gshow = 1
epsout = 1

[ T - T r a c k ]  $ flujo de particulas en yz
