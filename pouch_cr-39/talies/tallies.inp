$ Medimos dosis: 

[ T - D e p o s i t ]   $ histograma dosis-volumen CR39 + gel

title = Histograma
mesh = xyz
x-type = 2
xmin = -1.7500
xmax = 1.7500
nx = 35
y-type = 2
ymin = -1.3185
ymax = 1.8815
ny = 32
z-type = 2
zmin = 98.330
zmax = 98.580
nz = 10
part = proton
output = dose
unit = 0
axis = z
file = ./out/histograma_dosis_CR39.out
epsout = 1

$ Espectros a la entrada y salida:

[ T - C r o s s ]

title = Espectro entrada CR39
mesh = xyz
x-type = 2
xmin = -1.35
xmax = 1.35
nx = 1
y-type = 2
ymin = 1.0815
ymax = 1.8815
ny = 1
z-type = 1
nz = 0
98.3801
part = proton
e-type = 2
ne = 100
emin = 1.0e-9
emax = 25.0
output = f-curr
unit = 2
axis = eng
file = ./out/espectro_entrada_CR39.out
epsout = 1

[ T - C r o s s ]

title = Espectro salida CR39
mesh = xyz
x-type = 2
xmin = -1.35
xmax = 1.35
nx = 1
y-type = 2
ymin = -1.3185
ymax = 1.8815
ny = 1
z-type = 1
nz = 0
98.5799
part = proton
e-type = 2
ne = 100
emin = 1.0e-9
emax = 25.0
output = f-curr
unit = 2
axis = eng
file = ./out/espectro_salida_CR39.out
epsout = 1

$ Pico de Bragg (SOBP)

[ T - D e p o s i t ]  $ dosis depositada en profundidad
title = Bragg peak in cr
mesh = r-z
r-type = 2
rmin = 0.0
rmax = 0.5
nr = 1
z-type = 2 
zmin = 97
zmax = 100           
nz = 300                    
part = proton
output = dose
unit = 0
axis = z
file = ./out/bragg_cr.out
epsout = 1

