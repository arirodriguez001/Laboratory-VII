$$$$$$$$$$$$$$$$$$$$ PROTONES QUE ATRAVIESAN CADA INTERFAZ CR-39 $$$$$$$$$$$$$$$$$$
[T-Cross]
title = Proton current through CR39 interfaces
mesh = reg
reg = 24
r-from r-to area
$ ================= COLUMNA 1 =================
600 7011 1.0
7011 7012 1.0
7012 7013 1.0
7013 7014 1.0
7014 7015 1.0
7015 7016 1.0
7016 7017 1.0
7017 7018 1.0
7018 6003 1.0
$ ================= COLUMNA 2 =================
600 7021 1.0
7021 7022 1.0
7022 7023 1.0
7023 7024 1.0
7024 7025 1.0
7025 7026 1.0
7026 6003 1.0
$ ================= COLUMNA 3 =================
600 7031 1.0
7031 7032 1.0
7032 7033 1.0
7033 7034 1.0
7034 6003 1.0
$ ================= COLUMNA 4 =================
600 7041 1.0
7041 7042 1.0
7042 6003 1.0
part = proton
output = f-curr
unit = 1
axis = reg
file = ./out/corriente_CR39.out
epsout = 1

$$$$$$$$$$$$$$$$$$$$ PROTONES QUE ATRAVIESAN DE AIRE A GEL $$$$$$$$$$$$$$$$$$
[T-Cross]
title = Corriente de protones de aire a gel
mesh = reg
reg = 1
r-from r-to area
$ ================= COLUMNA 1 =================
2 600 1.0
part = proton
output = f-curr
unit = 1
axis = reg
file = ./out/corriente_aireagel.out
epsout = 1

$$$$$$$$$$$$$$$$$$$$ ESPECTROS EN CADA INTERFAZ CR-39 $$$$$$$$$$$$$$$$$$
[T-Cross]
title = Proton energy spectra through CR39 interfaces
mesh = reg
reg = 24
r-from r-to area
$ ================= COLUMNA 1 =================
600 7011 1.0
7011 7012 1.0
7012 7013 1.0
7013 7014 1.0
7014 7015 1.0
7015 7016 1.0
7016 7017 1.0
7017 7018 1.0
7018 6003 1.0
$ ================= COLUMNA 2 =================
600 7021 1.0
7021 7022 1.0
7022 7023 1.0
7023 7024 1.0
7024 7025 1.0
7025 7026 1.0
7026 6003 1.0
$ ================= COLUMNA 3 =================
600 7031 1.0
7031 7032 1.0
7032 7033 1.0
7033 7034 1.0
7034 6003 1.0
$ ================= COLUMNA 4 =================
600 7041 1.0
7041 7042 1.0
7042 6003 1.0
part = proton
e-type = 2
ne = 100
emin = 1.0e-3
emax = 25.0
output = f-curr
unit = 2
axis = eng
file = ./out/espectros_CR39.out
epsout = 1

$$$$$$$$$$$$$$$$$$$$ ESPECTRO AIRE A GEL $$$$$$$$$$$$$$$$$$
[T-Cross]
title = Proton energy spectra through CR39 interfaces
mesh = reg
reg = 1
r-from r-to area
$ ================= AIRE A GEL =================
2 600 1.0
part = proton
e-type = 2
ne = 100
emin = 1.0e-3
emax = 25.0
output = f-curr
unit = 2
axis = eng
file = ./out/espectro_airegel.out
epsout = 1

