xmin = -0.8
xmax = 0.8
nx = 16
y-type = 2                 
ymin = -1.65
ymax = 1.65
ny = 33 
z-type = 2
zmin = 98.38
zmax = 98.58
nz = 4
part = proton
output = dose
unit = 0
axis = z
file = ./out/histograma_dosis_L.out
epsout = 1

