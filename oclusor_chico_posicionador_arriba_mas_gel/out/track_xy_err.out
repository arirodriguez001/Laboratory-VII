[ T-Track ]
    title = [t-track] in xyz mesh
     mesh =  xyz            # mesh type is xyz scoring mesh
   x-type =    4            # x-mesh is linear given by xmin, xmax and xdel
     xmin =  -10.00000      # minimum value of x-mesh points
     xmax =   10.00000      # maximum value of x-mesh points
     xdel =  0.3000000      # mesh width of x-mesh points
#      nx =   67            # number of x-mesh points
#    data = ( x(i), i = 1, nx + 1 )
#          -1.00000E+01 -9.70000E+00 -9.40000E+00 -9.10000E+00 -8.80000E+00
#          -8.50000E+00 -8.20000E+00 -7.90000E+00 -7.60000E+00 -7.30000E+00
#          -7.00000E+00 -6.70000E+00 -6.40000E+00 -6.10000E+00 -5.80000E+00
#          -5.50000E+00 -5.20000E+00 -4.90000E+00 -4.60000E+00 -4.30000E+00
#          -4.00000E+00 -3.70000E+00 -3.40000E+00 -3.10000E+00 -2.80000E+00
#          -2.50000E+00 -2.20000E+00 -1.90000E+00 -1.60000E+00 -1.30000E+00
#          -1.00000E+00 -7.00000E-01 -4.00000E-01 -1.00000E-01  2.00000E-01
#           5.00000E-01  8.00000E-01  1.10000E+00  1.40000E+00  1.70000E+00
#           2.00000E+00  2.30000E+00  2.60000E+00  2.90000E+00  3.20000E+00
#           3.50000E+00  3.80000E+00  4.10000E+00  4.40000E+00  4.70000E+00
#           5.00000E+00  5.30000E+00  5.60000E+00  5.90000E+00  6.20000E+00
#           6.50000E+00  6.80000E+00  7.10000E+00  7.40000E+00  7.70000E+00
#           8.00000E+00  8.30000E+00  8.60000E+00  8.90000E+00  9.20000E+00
#           9.50000E+00  9.80000E+00  1.01000E+01
   y-type =    4            # y-mesh is linear given by ymin, ymax and ydel
     ymin =  -10.00000      # minimum value of y-mesh points
     ymax =   10.00000      # maximum value of y-mesh points
     ydel =  0.3000000      # mesh width of y-mesh points
#      ny =   67            # number of y-mesh points
#    data = ( y(i), i = 1, ny + 1 )
#          -1.00000E+01 -9.70000E+00 -9.40000E+00 -9.10000E+00 -8.80000E+00
#          -8.50000E+00 -8.20000E+00 -7.90000E+00 -7.60000E+00 -7.30000E+00
#          -7.00000E+00 -6.70000E+00 -6.40000E+00 -6.10000E+00 -5.80000E+00
#          -5.50000E+00 -5.20000E+00 -4.90000E+00 -4.60000E+00 -4.30000E+00
#          -4.00000E+00 -3.70000E+00 -3.40000E+00 -3.10000E+00 -2.80000E+00
#          -2.50000E+00 -2.20000E+00 -1.90000E+00 -1.60000E+00 -1.30000E+00
#          -1.00000E+00 -7.00000E-01 -4.00000E-01 -1.00000E-01  2.00000E-01
#           5.00000E-01  8.00000E-01  1.10000E+00  1.40000E+00  1.70000E+00
#           2.00000E+00  2.30000E+00  2.60000E+00  2.90000E+00  3.20000E+00
#           3.50000E+00  3.80000E+00  4.10000E+00  4.40000E+00  4.70000E+00
#           5.00000E+00  5.30000E+00  5.60000E+00  5.90000E+00  6.20000E+00
#           6.50000E+00  6.80000E+00  7.10000E+00  7.40000E+00  7.70000E+00
#           8.00000E+00  8.30000E+00  8.60000E+00  8.90000E+00  9.20000E+00
#           9.50000E+00  9.80000E+00  1.01000E+01
   z-type =    1            # z-mesh is given by the below data
       nz =      1          # number of z-mesh points
#    data = ( z(i), i = 1, nz + 1 )
            6.04700E+01  6.04900E+01
   e-type =    1            # e-mesh is given by the below data
       ne =      1          # number of e-mesh points
#    data = ( e(i), i = 1, ne + 1 )
            0.00000E+00  1.00000E+03
     unit =    1            # unit is [1/cm^2/source]
 material =  all            # (D=all) number of specific material
  2D-type =    3            # 1:Cont, 2:Clust, 3:Color, 4:xyz, 5:mat, 6:Clust+Cont, 7:Col+Cont
     axis =      xy            # axis of output
     file = ./out/track_xy.out  # file name of output for the above axis
     part =  proton     photon   
# kf/name :  2212       22       
    gshow =    1            # 0: no 1:bnd, 2:bnd+mat, 3:bnd+reg 4:bnd+lat 5:bmp style
    resol =    1            # (D=1) resolution of gshow or rshow
    width = 0.5000000       # (D=0.5) width of lines for gshow or rshow
   epsout =    1            # (D=0) generate eps file by ANGEL
#    used :        main (  %)        temp (  %)       total (  %)
#  memory :         144 (  0)           0 (  0)         144 (  0)

