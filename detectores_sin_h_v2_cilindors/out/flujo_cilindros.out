[ T-Track ]
    title = [t-track] in region mesh
     mesh =  reg            # mesh type is region-wise
      reg = ( 20002 < 20005 ) ( 20002 < 20006 ) ( 20002 < 20007 ) (
            20002 < 20008 ) ( 20002 < 20009 )
   volume                   # combined, lattice or level structure 
   non     reg      vol     # reg definition
    1  1000001   1.0000E+00 # ( 20002 < 20005 )
    2  1000002   1.0000E+00 # ( 20002 < 20006 )
    3  1000003   1.0000E+00 # ( 20002 < 20007 )
    4  1000004   1.0000E+00 # ( 20002 < 20008 )
    5  1000005   1.0000E+00 # ( 20002 < 20009 )
   e-type =    1            # e-mesh is given by the below data
       ne =      1          # number of e-mesh points
#    data = ( e(i), i = 1, ne + 1 )
            0.00000E+00  1.00000E+03
     unit =    1            # unit is [1/cm^2/source]
 material =  all            # (D=all) number of specific material
     axis =     reg            # axis of output
     file = ./out/flujo_cilindros.out  # file name of output for the above axis
     part =  proton   
# kf/name :  2212     
    gshow =    1            # 0: no 1:bnd, 2:bnd+mat, 3:bnd+reg 4:bnd+lat 5:bmp style
    resol =    1            # (D=1) resolution of gshow or rshow
    width = 0.5000000       # (D=0.5) width of lines for gshow or rshow
   epsout =    1            # (D=0) generate eps file by ANGEL
#    used :        main (  %)        temp (  %)       total (  %)
#  memory :          34 (  0)           0 (  0)          34 (  0)

#------------------------------------------------------------------------------
#newpage:
#   no. =  1
#  ie =  1
#   e = (   0.0000E+00  -   1.0000E+03  )

x: Serial Num. of Region
y: Flux [1/cm^2/source]              
p: xlin ylog afac(0.8) form(0.9)
h:   x      n     n          y(proton  ),l3 n  
#  num    reg     volume       proton    r.err 
    1 1000001   1.0000E+00   6.7125E+04  0.0030
    2 1000002   1.0000E+00   9.2862E+03  0.0079
    3 1000003   1.0000E+00   1.0995E+03  0.0226
    4 1000004   1.0000E+00   4.0336E+03  0.0119
    5 1000005   1.0000E+00   1.2744E+03  0.0209

#   sum over    5.0000E+00   1.6564E+04  0.0027

'no. =  1,  ie =  1'
msuc: {\huge [t-track] in region mesh}
msdr: {\it plotted by \ANGEL \version}
msdl: {\it calculated by \PHITS  3.36}
wt: s(0.7)
\vspace{-3}
  emin  &=&   0.0000E+00 [MeV/n]
  emax  &=&   1.0000E+03 [MeV/n]
e:
 
# Information for Restart Calculation
# This calculation was newly started
# istdev =  2 # 1:Batch variance, 2:History variance
# resc2  = 3.20436999323052807E-01 # Total source weight or Total source weight / maxcas
# resc3  = 2.00000998100000000E+09 # Total history number or Total batch number
# maxcas =       10001 # History / Batch, only used for istdev=1
# bitrseed = 1001001000011111100100111110000001011011100111110000101100101100 # bit data of rseed
