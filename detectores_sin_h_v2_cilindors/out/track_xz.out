[ T-Track ]
    title = [t-track] in xyz mesh
     mesh =  xyz            # mesh type is xyz scoring mesh
   x-type =    2            # x-mesh is linear given by xmin, xmax and nx
     xmin = -1.0000000E-02  # minimum value of x-mesh points
     xmax =  1.0000000E-02  # maximum value of x-mesh points
#    xdel =  2.0000000E-02  # mesh width of x-mesh points
       nx =      1          # number of x-mesh points
#    data = ( x(i), i = 1, nx + 1 )
#          -1.00000E-02  1.00000E-02
   y-type =    4            # y-mesh is linear given by ymin, ymax and ydel
