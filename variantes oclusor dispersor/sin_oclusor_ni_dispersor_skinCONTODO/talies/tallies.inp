[ T - T r a c k ] off
$ Antes del primer dispersor. Centro: z = 6.85 cm.
mesh = xyz
x-type = 4
xdel = 0.3
xmin = -10
xmax = 10
y-type = 4
ydel = 0.3
ymin = -15
ymax = 15
z-type = 1
nz = 1
6.840 6.860
part = proton
e-type = 1
ne = 1
0.0 1000.0
unit = 1
axis = xy
file = ./out/track_xy_antes_disp1.out
gshow = 1
epsout = 1

