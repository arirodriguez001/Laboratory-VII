[ T-Cross ]
    title = Comparacion del espectro antes y despues del gel
     mesh = reg            # Malla basada en regiones/celdas [1]
      reg = 1              # Evaluamos 2 fronteras de cruce [1]
      r-from   r-to       area
      2        600        1.0   $ Frontera 1: Entrada al Gel
   e-type = 2              # 2: Malla de energía lineal [2]
     emin = 1.0e-3            # Energía mínima [MeV] [1]
     emax = 25.0           # Ajusta al valor máximo de tu haz [MeV] [1]
       ne = 100            # 100 bins (da una resolución de 0.1 MeV por bin) [1]
     unit = 2              # 2: [1/cm^2/MeV/fuente] (distribución espectral) [3]
     axis = eng            # Eje X: Energía [1]
   output = flux           # Fluencia de cruce (o 'current' para corriente) [1]
     part = proton         # Especifica tu partícula (ej. proton, electron, photon) [1]
     file = espectro_aireagel.out   # Archivo de salida numérico [1]
   epsout = 1              # Genera el gráfico en formato EPS [3]

