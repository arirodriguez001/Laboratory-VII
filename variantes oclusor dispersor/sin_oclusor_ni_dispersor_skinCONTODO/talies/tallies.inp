$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$

[T-Deposit]
title = Dosis en region 700
mesh = reg
reg = 510
part = proton
output = dose
unit = 0
axis = reg
file = ./out/dosis.out
epsout = 1

[T-Track]
title = Espectro de protones en region
mesh = reg
reg = 510
part = proton

e-type = 2
emin = 0.0
emax = 25.0
ne = 20

axis = eng
unit = 2
file = ./out/espectro.out
epsout = 1

[ T - D e p o s i t ]

title = Bragg peak in pouch

mesh = r-z
r-type = 2
rmin = 0.0
rmax = 0.5
nr = 1

z-type = 2 
zmin = 97
zmax = 100           
nz = 300                    

part = proton
output = dose
unit = 0
axis = z
file = ./out/bragg_pouch.out
epsout = 1

[ T - D e p o s i t ]  $ dosis radial en el pouch
title = Bragg peak in pouch, ahora con radio 1
mesh = r-z
r-type = 2
rmin = 0.0
rmax = 1.7     
nr = 60
z-type = 2
zmin = 98.38
zmax = 98.58
nz = 1
part = proton
output = dose
unit = 0
axis = r
file = ./out/bragg_pouch_r.out
epsout = 1

[ T - D e p o s i t ]   $ histograma dosis-volumen del pouch
title = Histograma
mesh = xyz
x-type = 2               
xmin = -0.8
xmax = 0.8
nx = 16
y-type = 2                 
ymin = -1.65
ymax = 1.65
ny = 33 
z-type = 2
zmin = 98.38
zmax = 98.58
nz = 4
part = proton
output = dose
unit = 0
axis = z
file = ./out/histograma_dosis.out
epsout = 1