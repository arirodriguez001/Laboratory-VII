[T-Deposit]
title = Dosis en region pouch
mesh = reg
reg = 510
part = proton
output = dose
unit = 0
axis = reg
file = ./out/dosispouch.out
epsout = 1

[T-Deposit]
title = Dosis en region gel
mesh = reg
reg = 600
part = proton
output = dose
unit = 0
axis = reg
file = ./out/dosisgel.out
epsout = 1

