x: z[cm]
y: Dose [Gy/source]      
p: xlin ylog afac(0.8) form(0.9)
h: n            x            y(proton  ),hh0l n 
#  z-lower      z-upper        proton    r.err 
   9.8380E+01   9.8430E+01   0.0000E+00  0.0000
   9.8430E+01   9.8480E+01   0.0000E+00  0.0000
   9.8480E+01   9.8530E+01   0.0000E+00  0.0000
   9.8530E+01   9.8580E+01   0.0000E+00  0.0000

#   sum over    2.0000E-03   0.0000E+00  0.0000

'no. =  1,  ix =  1,  iy =  1'
