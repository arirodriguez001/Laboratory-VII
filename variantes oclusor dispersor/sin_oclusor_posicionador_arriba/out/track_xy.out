#           9.50000E+00  9.80000E+00  1.01000E+01
   y-type =    4            # y-mesh is linear given by ymin, ymax and ydel
     ymin =  -10.00000      # minimum value of y-mesh points
     ymax =   10.00000      # maximum value of y-mesh points
     ydel =  0.3000000      # mesh width of y-mesh points
#      ny =   67            # number of y-mesh points
#    data = ( y(i), i = 1, ny + 1 )
#          -1.00000E+01 -9.70000E+00 -9.40000E+00 -9.10000E+00 -8.80000E+00
