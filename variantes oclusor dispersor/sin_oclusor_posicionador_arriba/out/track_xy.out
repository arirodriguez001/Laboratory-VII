[ T-Track ]
    title = [t-track] in xyz mesh
     mesh =  xyz            # mesh type is xyz scoring mesh
   x-type =    4            # x-mesh is linear given by xmin, xmax and xdel
     xmin =  -10.00000      # minimum value of x-mesh points
     xmax =   10.00000      # maximum value of x-mesh points
     xdel =  0.3000000      # mesh width of x-mesh points
#      nx =   67            # number of x-mesh points
#    data = ( x(i), i = 1, nx + 1 )
#          -1.00000E+01 -9.70000E+00 -9.40000E+00 -9.10000E+00 -8.80000E+00
#          -8.50000E+00 -8.20000E+00 -7.90000E+00 -7.60000E+00 -7.30000E+00
