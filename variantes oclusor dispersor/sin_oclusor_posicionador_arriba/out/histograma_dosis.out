   6.0480E+01   6.0530E+01   2.9358E-04  0.5519
   6.0530E+01   6.0580E+01   2.6059E-04  0.6461

#   sum over    2.0000E-03   1.8035E-04  0.4420

'no. =  1,  ix =  1,  iy =  1'
msuc: {\huge Histograma}
msdr: {\it plotted by \ANGEL \version}
msdl: {\it calculated by \PHITS  3.36}
wt: s(0.7)
\vspace{-3}
