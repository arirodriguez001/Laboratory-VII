set: c70[ 0.146255 ]	$pin radius r = sqrt(0.24 * 0.28 / pi)
set: c701[ 0.04/2 ]	$step 1 width
set: c702[ 0.04/2 ]	$step 2 width
set: c703[ 0.05/2 ]	$step 3 width
set: c704[ 0.05/2 ]	$step 4 width
set: c705[ 0.05/2 ]	$step 5 width
set: c706[ 0.06/2 ]	$step 6 width
set: c707[ 0.07/2 ]	$step 7 width
set: c708[ 0.09/2 ]	$step 8 width
set: c709[ 0.18/2 ]	$step 9 width
set: c71[ c701 + c702 + c703 + c704 + c705 + c706 + c707 + c708 + c709 ]	$half width
set: c75[ 0.02 ]	$steps thickness
set: c76[ 0.5 ]	$Ridge filter 3D print base thickness
set: c77[ -c76 + 0.42 ]	$steps max height - depth from printed surface
set: %pin_TR%[60]	$attn translation number (leave blank for not)

$[ Surface ]
$ workspace
1600 PX  -30.0
1601 PX   30.0
1602 PY  -19.0
1603 PY   19.0
1604 %pin_TR% PZ  0.0
1605 %pin_TR% PZ  0.43	$bottom of the plate
1621 %pin_TR% PZ (-c76)
1623 %pin_TR% PZ (c76)
set:%pin_zone%[1621 -1623]	$use with %workzone%


$ PiN diodes
1607 C/Z  4.5  4.5  c70
1608 C/Z  4.5 -4.5  c70
1609 C/Z -4.5  4.5  c70
1610 C/Z -4.5 -4.5  c70
set:%pin_diodes%[1604 -1605 (-1607:-1608:-1609:-1610)]

$Pin diodes plate
1611 PX -14.75 
1612 PX  14.75 
1613 PY -9.5 
1614 PY  9.5 

$beam hole (square)
1615 PX -2.5
1616 PX  2.5
1617 PY -2.5
1618 PY  2.5
set:%pins_plate%[1611 -1612 1613 -1614 1604 -1605 #(1615 -1616 1617 -1618)]


$RIDGE FILTER body 3D printed
1619 PX -3.75
1620 PX  3.75
1622 PY  3.1
1624 CZ  2.25	$beam hole

$RIDGE FILTER TAB 3D printed
1625 PX  -8.5
1626 PY (-2.5+2.0)
set:%ridge_filter_base%[1617 1624 ((1615 -1616 -1618 1604 -1623):(((1619 -1622):(1625 -1626)) -1620 1621 -1604))]

$RIDGE filter grid zone
1627 %pin_TR% PZ (c77)
$1628 PX  2.0	$real print limit
1629 %pin_TR% PZ (c77+8*c75)	$bottom of ladders
set:%ridge_filter_grid%[1627 -1629 -1624] 

$RIDGE filter unit (U=1)
1630 PX -(c71)
1631 PX  (c71)
set:%ridge_unit%[1630 -1631]

$RIDGE filter ladder (U=2)
$step 1
1632 PX -(c701)
1633 PX  (c701)
1634 %pin_TR% PZ (c77+c75)
$step 2
1635 PX -(c701+c702)
1636 PX  (c701+c702)
1637 %pin_TR% PZ (c77+2*c75)
$step 3
1638 PX -(c701+c702+c703)
1639 PX  (c701+c702+c703)
1640 %pin_TR% PZ (c77+3*c75)
$step 4
1641 PX -(c701+c702+c703+c704)
1642 PX  (c701+c702+c703+c704)
1643 %pin_TR% PZ (c77+4*c75)
$step 5
1644 PX -(c701+c702+c703+c704+c705)
1645 PX  (c701+c702+c703+c704+c705)
1646 %pin_TR% PZ (c77+5*c75)
$step 6
1647 PX -(c701+c702+c703+c704+c705+c706)
1648 PX  (c701+c702+c703+c704+c705+c706)
1649 %pin_TR% PZ (c77+6*c75)
$step 7
1650 PX -(c701+c702+c703+c704+c705+c706+c707)
1651 PX  (c701+c702+c703+c704+c705+c706+c707)
1652 %pin_TR% PZ (c77+7*c75)
$step 8
1653 PX -(c701+c702+c703+c704+c705+c706+c707+c708)
1654 PX  (c701+c702+c703+c704+c705+c706+c707+c708)
set:%ridge_ladder_a%[(1632 -1633):(1634 1635 -1636):(1637 1638 -1639):(1640 1641 -1642):(1643 1644 -1645)]
