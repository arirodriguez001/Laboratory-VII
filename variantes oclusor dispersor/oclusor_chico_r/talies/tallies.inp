$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$

[T-Deposit] 
title = Dosis en region 700
mesh = reg
reg = 700
part = proton
output = dose
unit = 0
axis = reg
file = ./out/dosis_region5.out
epsout = 1

[T-Track] off 
title = Espectro de protones en region 700
mesh = reg
reg = 700
part = proton

e-type = 2
emin = 0.0
emax = 25.0
ne = 20

axis = eng
unit = 2
file = ./out/espectro_region5.out
epsout = 1

[ T - D e p o s i t ] 

title = Bragg peak in pouch

mesh = r-z
r-type = 2
rmin = 0.0
rmax = 0.5
nr = 1

z-type = 2 
zmin = 97
zmax = 100           
nz = 70                    

part = proton
output = dose
unit = 0
axis = z
file = ./out/bragg_pouch_water.out
epsout = 1


